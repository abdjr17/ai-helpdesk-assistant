# Copy this file to a new file named ".env" (exactly that name) and fill in the values.
# The .env file is private. It is in .gitignore, so it will NOT be uploaded to GitHub.

# mock = fake answers, no key needed (good for testing). live = real AI answers.
LLM_MODE=mock

# --- Only needed for LLM_MODE=live ---
# OPTION A: Google Gemini (free tier, key from aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=paste_your_key_here
# Copy a current model name from the provider documentation (a "flash" model is cheap and fast).
LLM_MODEL=paste_model_name_here

# OPTION B: OpenAI -> LLM_BASE_URL=https://api.openai.com/v1
# OPTION C: local Ollama (free, runs on your computer) -> LLM_BASE_URL=http://localhost:11434/v1 and LLM_API_KEY=ollama
